<?xml version="1.0" encoding="UTF-8"?>
<!--
  Legacy Ant wrapper. Prefer: npm run build:production && npx gulp xar
-->
<project default="xar" name="existdb-dashboard">
    <xmlproperty file="expath-pkg.xml"/>
    <property name="project.version" value="${package(version)}"/>
    <property name="project.app" value="${package(abbrev)}"/>
    <property name="build.dir" value="build"/>
    <target name="xar" description="Run npm/gulp build (requires Node 24+)">
        <echo message="Use: npm run build:production &amp;&amp; npx gulp xar"/>
        <exec executable="npm" failonerror="true">
            <arg value="run"/>
            <arg value="build:production"/>
        </exec>
        <exec executable="npx" failonerror="true">
            <arg value="gulp"/>
            <arg value="xar"/>
        </exec>
    </target>
</project>
